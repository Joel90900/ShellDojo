# ============================================================
# SHELLDOJO - CONFIGURACIÓN DE CONEXIÓN A POSTGRESQL
# Copia este archivo como .env y coloca tu contraseña de PostgreSQL
# ============================================================

# URL de conexión estándar a PostgreSQL:
# Formato: postgresql://[USUARIO]:[CONTRASEÑA]@[HOST]:[PUERTO]/[BASE_DE_DATOS]
DATABASE_URL=postgresql://postgres:admin@localhost:5432/shelldojo

# O parámetros individuales:
PGUSER=postgres
PGPASSWORD=admin
PGHOST=localhost
PGPORT=5432
PGDATABASE=shelldojo

PORT=3000

